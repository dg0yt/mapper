{
  "name": "openorienteering-mapper",
  "dependencies": [
    {
      "name": "gdal",
      "default-features": false,
      "features": [
        "archive",
        "expat",
        "jpeg",
        "libkml",
        "lzma",
        "openjpeg",
        "png",
        "sqlite3",
        "webp",
        "zstd"
      ]
    },
    "polyclipping",
    {
      "name": "proj",
      "default-features": false,
      "features": [
        "tiff"
      ]
    },
    {
      "name": "qt5-androidextras",
      "platform": "android"
    },
    {
      "name": "qt5-base",
      "default-features": false
    },
    {
      "name": "qt5-imageformats",
      "default-features": false
    },
    {
      "name": "qt5-location",
      "default-features": false
    },
    {
      "name": "qt5-sensors",
      "default-features": false
    },
    {
      "name": "qt5-tools",
      "default-features": false
    },
    "qt5-translations",
    "zlib"
  ],
  "default-features": [
    "transitive-dependencies"
  ],
  "features": {
    "transitive-dependencies": {
      "description": "A grouping of feature specifications for transitive dependencies",
      "dependencies": [
        {
          "$comment": "qt5-base needs qt5-base:host needs fontconfig:host.",
          "name": "fontconfig",
          "host": true,
          "default-features": false
        },
        {
          "$comment": "qt5-base needs qt5-base:host needs freetype:host.",
          "name": "freetype",
          "host": true,
          "default-features": false
        },
        {
          "$comment": "gdal needs libarchive.",
          "name": "libarchive",
          "default-features": false,
          "features": [
            "lzma",
            "zstd"
          ]
        },
        {
          "$comment": "qt5-base needs qt5-base:host.",
          "name": "qt5-base",
          "host": true,
          "default-features": false
        },
        {
          "$comment": "gdal, proj, qt5-base need tiff.",
          "name": "tiff",
          "features": [
            "webp",
            "zstd"
          ]
        }
      ]
    }
  }
}
